{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-standards-template.local/schemas/oscal_v1_2_0_subset.schema.json",
  "title": "OSCAL v1.2.0 Subset Validation Schema",
  "description": "Validates the deterministic OSCAL v1.2.0 JSON models generated by export_oscal.py.",
  "type": "object",
  "oneOf": [
    { "required": ["catalog"], "properties": { "catalog": { "$ref": "#/$defs/oscalCatalog" } } },
    { "required": ["profile"], "properties": { "profile": { "$ref": "#/$defs/oscalProfile" } } },
    { "required": ["component-definition"], "properties": { "component-definition": { "$ref": "#/$defs/oscalComponentDefinition" } } },
    { "required": ["mapping-collection"], "properties": { "mapping-collection": { "$ref": "#/$defs/oscalMappingCollection" } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-5[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Standard RFC 4122 UUIDv5 format"
    },
    "oscalMetadata": {
      "type": "object",
      "required": ["title", "last-modified", "version", "oscal-version"],
      "properties": {
        "title": { "type": "string" },
        "published": { "type": "string" },
        "last-modified": { "type": "string" },
        "version": { "type": "string" },
        "oscal-version": { "type": "string", "const": "1.2.0" },
        "remarks": { "type": "string" }
      },
      "additionalProperties": true
    },
    "oscalCatalog": {
      "type": "object",
      "required": ["uuid", "metadata", "groups"],
      "properties": {
        "uuid": { "$ref": "#/$defs/uuid" },
        "metadata": { "$ref": "#/$defs/oscalMetadata" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "controls"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "props": { "type": "array" },
                    "parts": { "type": "array" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "oscalProfile": {
      "type": "object",
      "required": ["uuid", "metadata", "imports"],
      "properties": {
        "uuid": { "$ref": "#/$defs/uuid" },
        "metadata": { "$ref": "#/$defs/oscalMetadata" },
        "imports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["href"],
            "properties": {
              "href": { "type": "string" },
              "include-controls": { "type": "array" }
            },
            "additionalProperties": true
          }
        },
        "merge": { "type": "object" },
        "modify": { "type": "object" }
      },
      "additionalProperties": false
    },
    "oscalComponentDefinition": {
      "type": "object",
      "required": ["uuid", "metadata", "components"],
      "properties": {
        "uuid": { "$ref": "#/$defs/uuid" },
        "metadata": { "$ref": "#/$defs/oscalMetadata" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "type", "title", "description"],
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "type": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "control-implementations": { "type": "array" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "oscalMappingCollection": {
      "type": "object",
      "required": ["uuid", "metadata", "mappings"],
      "properties": {
        "uuid": { "$ref": "#/$defs/uuid" },
        "metadata": { "$ref": "#/$defs/oscalMetadata" },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_control_id", "target_framework", "target_control_id"],
            "properties": {
              "source_control_id": { "type": "string" },
              "target_framework": { "type": "string" },
              "target_control_id": { "type": "string" },
              "relationship": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  }
}
