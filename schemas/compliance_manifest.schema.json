{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-standards-template.local/schemas/compliance_manifest.schema.json",
  "title": "Compliance Manifest Schema",
  "description": "Validates adopted compliance frameworks, coverage thresholds, document review cadence, and time-bound exceptions.",
  "type": "object",
  "required": [
    "schema_version",
    "organization",
    "review_policy",
    "adopted_frameworks",
    "thresholds",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "organization": {
      "type": "object",
      "required": ["name", "ciso"],
      "properties": {
        "name": { "type": "string" },
        "ciso": { "type": "string" },
        "dpo": { "type": "string" },
        "author": { "type": "string" }
      },
      "additionalProperties": false
    },
    "review_policy": {
      "type": "object",
      "required": ["max_age_days", "cadence"],
      "properties": {
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "cadence": {
          "type": "string",
          "enum": ["annual", "semi-annual", "quarterly"]
        },
        "enforce_approval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "adopted_frameworks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "framework_id",
          "name",
          "target_coverage_pct",
          "enforcement"
        ],
        "properties": {
          "framework_id": {
            "type": "string",
            "enum": [
              "iso_27001_2022",
              "soc2_tsc_2017",
              "nist_csf_2_0",
              "gdpr",
              "nist_sp_800_53_rev5",
              "asd_essential_eight"
            ]
          },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "target_coverage_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "target_maturity_level": {
            "type": "string",
            "enum": ["ML1", "ML2", "ML3"]
          },
          "target_baseline": {
            "type": "string",
            "enum": ["Low", "Moderate", "High"]
          },
          "enforcement": {
            "type": "string",
            "enum": ["mandatory", "advisory", "planned"]
          }
        },
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "min_canonical_controls",
        "min_distinct_csf_subcategories",
        "min_distinct_nist_800_53_controls",
        "min_essential_eight_strategies"
      ],
      "properties": {
        "min_canonical_controls": {
          "type": "integer",
          "minimum": 55
        },
        "min_distinct_csf_subcategories": {
          "type": "integer",
          "minimum": 45
        },
        "min_distinct_nist_800_53_controls": {
          "type": "integer",
          "minimum": 85
        },
        "min_essential_eight_strategies": {
          "type": "integer",
          "minimum": 8,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityException" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "securityException": {
      "type": "object",
      "required": [
        "id",
        "control_id",
        "title",
        "justification",
        "approved_by",
        "approval_date",
        "expiration_date",
        "risk_level",
        "status",
        "compensating_controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-\\d{4}-\\d{3,}$"
        },
        "control_id": { "type": "string" },
        "title": { "type": "string" },
        "justification": { "type": "string" },
        "approved_by": { "type": "string" },
        "approval_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expiration_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "risk_level": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired", "remediated"]
        },
        "compensating_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
